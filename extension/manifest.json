{
  "manifest_version": 3,
  "name": "Focus Up",
  "version": "0.1.0",
  "description": "Focus sessions: 3 tabs only, no notifications, a session timer and a calendar.",
  "permissions": [
    "tabs",
    "storage",
    "webNavigation",
    "contentSettings",
    "scripting",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Focus Up"
  },
  "options_ui": {
    "page": "dashboard.html",
    "open_in_tab": true
  },
  "key": ""
}
